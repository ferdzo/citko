# Copy to .env; do not commit .env. Use long unique random values.
POSTGRES_DB=citko
POSTGRES_USER=citko
POSTGRES_PASSWORD=replace-with-long-random-secret
SETUP_TOKEN=replace-with-another-long-random-secret

# Object storage encryption/authentication. Generate FS_MASTER_KEY with
# `openssl rand -base64 32`; retain it in a secure recovery system/backups.
FS_MASTER_KEY=replace-with-base64-encoded-32-random-bytes
FS_ROOT_USER=fs-root
FS_ROOT_PASSWORD=replace-with-a-third-long-random-secret
ADMIN_API_ENABLED=false

# Provision a distinct, bucket-scoped application key using the official fs
# admin API before first start; never use the fs root credentials here.
S3_ACCESS_KEY_ID=replace-with-scoped-application-key
S3_SECRET_ACCESS_KEY=replace-with-scoped-application-secret

# Public HTTPS production example. Must match the browser origin exactly.
APP_ENV=production
SITE_ADDRESS=books.example.com
ALLOWED_ORIGINS=https://books.example.com
HTTP_PORT=80
HTTPS_PORT=443
MAX_UPLOAD_BYTES=104857600
LOG_LEVEL=INFO

# For explicit local HTTP development only: APP_ENV=development,
# SITE_ADDRESS=:80, ALLOWED_ORIGINS=http://localhost:8080,
# HTTP_PORT=8080 and HTTPS_PORT=8443. Cookies are then not Secure.
